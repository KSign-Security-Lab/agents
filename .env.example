# ============================================================================
#  Copy to .env. This is the only file you edit, on any machine.
#
#      docker compose up -d      docker compose ps
#      docker compose down       docker compose logs -f vllm
#
#  Sections below are grouped by the container they configure, so you can jump
#  to the one you are tuning. Anything commented out shows its default and can
#  stay that way — nothing needs listing just to keep its default.
# ============================================================================


# ─────────────────────────────────────────────────────────────────────────────
#  WHAT THIS MACHINE IS
# ─────────────────────────────────────────────────────────────────────────────
#  dev     postgres + redis            what a developer's machine runs
#  ingest  worker                      add to dev, to debug ingest
#
#  Combine with a comma: `dev,ingest`. `docker compose config --profiles` lists
#  them; --services shows what this file currently starts.
#
#  Everything with a GPU is in Kubernetes now — see k8s/. api and web are not in
#  compose either: `pnpm dev` runs them on the host so they hot-reload.
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=dev


# ─────────────────────────────────────────────────────────────────────────────
#  EVERY CONTAINER
# ─────────────────────────────────────────────────────────────────────────────
# DATA_ROOT=./data     uploads, postgres and redis all live under here


# ─────────────────────────────────────────────────────────────────────────────
#  postgres, redis (profile: dev)                 the app's state
# ─────────────────────────────────────────────────────────────────────────────
# Ports are offset from 5432/6379 so they cannot collide with a Postgres or Redis
# you already run. api builds DATABASE_URL from these — see config.py.
# POSTGRES_PORT=5433
# REDIS_PORT=6380
# POSTGRES_USER=agents
# POSTGRES_PASSWORD=agents
# POSTGRES_DB=agents


# ─────────────────────────────────────────────────────────────────────────────
#  api + web       (not containers)               `pnpm dev`, on your host
# ─────────────────────────────────────────────────────────────────────────────
# Any node of the Kubernetes cluster serving the models. LLM_BASE_URL and
# INFER_BASE_URL are built from it, using the NodePorts 30862 and 30863 — the
# Service routes to whichever pod is ready, so any node's IP works and you do
# not care which machine answers.
GPU_HOST=10.0.0.11

# ADMIN_EMAIL=dev@agents.dev      `pnpm seed` creates/resets this account
# ADMIN_PASSWORD=devdev
#
# The ports for these two are NOT read from here: pnpm does not load .env, so
# they are arguments in package.json, defaulting to 8000 and 3000. Override for
# one run inline — `API_PORT=8123 pnpm api` — or edit the script. Everything else
# in this section does come from this file, because apps/api/app/config.py reads
# it by absolute path.


# ─────────────────────────────────────────────────────────────────────────────
#  Everything else
# ─────────────────────────────────────────────────────────────────────────────
#  OCR, chunking, retrieval, agent and topic tuning are Settings fields in
#  apps/api/app/config.py, each sitting next to the measurement that chose its
#  value. Add any of them here as UPPER_CASE to override.
