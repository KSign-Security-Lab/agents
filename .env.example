# ============================================================================
#  Copy to .env, set the first line, and you're done:
#
#      docker compose up -d      docker compose ps
#      docker compose down       docker compose logs -f vllm-a
#
#  COMPOSE_PROFILES is what makes those plain commands work — it tells compose
#  what this machine is, so there are no -f or --profile flags to remember.
# ============================================================================

# ---------------------------------------------------------------------------
#  What does this machine run?  There are four profiles, and compose will list
#  them for you at any time:
#
#      docker compose config --profiles     every profile this file defines
#      docker compose config --services     what your current .env starts
#
#    dev        postgres + redis          a developer's machine
#    gpu        llm-gateway, vllm, infer   a GPU server
#    ingest     worker                     add to dev, to debug ingest
#    replica2   a second vllm              add to gpu, load split across 2 GPUs
#
#  Combine with commas: `dev,ingest`, or `gpu,dev` for both roles on one box.
#  You can also skip this entirely and name services — `docker compose up -d
#  postgres redis` activates their profile on the spot.
#
#  api and web aren't in compose at all: `./dev` runs them on the host
#  so they hot-reload. See the README.
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=dev

# ---------------------------------------------------------------------------
#  Dev role
# ---------------------------------------------------------------------------
# The GPU server to talk to. LLM_BASE_URL and INFER_BASE_URL derive from it.
# localhost assumes an SSH tunnel, which needs no change on the server:
#   ssh -N -L 8602:localhost:8602 -L 8603:localhost:8603 <gpu-host>
GPU_HOST=localhost

# ---------------------------------------------------------------------------
#  GPU role. Ignored unless COMPOSE_PROFILES includes gpu.
# ---------------------------------------------------------------------------
# CUDA device indices. Note these default to *different* cards, so set both if
# you want them together.
VLLM_A_GPUS=0
INFER_GPUS=1
# To split ONE model across two cards, give vllm both and tell it to split them
# — this is a flag, not a profile:
#   VLLM_A_GPUS=0,1
#   TENSOR_PARALLEL=2
# VLLM_B_GPUS=1        # only used by the replica2 profile

# MODEL_ID and TOOL_CALL_PARSER travel together: the parser must match the format
# the model's chat template emits (EXAONE 4.0 emits Hermes).
#
# !! EXAONE 4.0's licence (§3.1) forbids commercial use of the model AND its
# !! output. Internal / non-revenue use only. For a commercial deployment swap to
# !! Apache-2.0: MODEL_ID=Qwen/Qwen3-32B-AWQ needs no other edit.
MODEL_ID=LGAI-EXAONE/EXAONE-4.0-32B-AWQ
TOOL_CALL_PARSER=hermes

# 0.0.0.0 publishes the gateway and infer beyond loopback, which is what a
# developer's GPU_HOST points at. Neither authenticates, so only on a trusted
# network — the SSH tunnel above is the alternative.
BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
#  Overrides. The commented value is the default; see compose.yaml and
#  apps/api/app/config.py for everything not listed.
# ---------------------------------------------------------------------------
# DATA_ROOT=./data          # weights, uploads, postgres, redis — all under here
# POSTGRES_PORT=5433        # offset from 5432 so it can't hit a local Postgres
# REDIS_PORT=6380
# LLM_GATEWAY_PORT=8602
# INFER_PORT=8603
# API_PORT=8000             # host processes
# WEB_PORT=3000
# ADMIN_EMAIL=dev@agents.dev
# ADMIN_PASSWORD=devdev
# MAX_MODEL_LEN=32768
# GPU_MEMORY_UTILIZATION=0.62
