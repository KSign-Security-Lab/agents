# ============================================================================
#  Copy to .env, set the first line, and you're done:
#
#      docker compose up -d      docker compose ps
#      docker compose down       docker compose logs -f vllm
#
#  COMPOSE_PROFILES is what makes those plain commands work — it tells compose
#  what this machine is, so there are no -f or --profile flags to remember.
# ============================================================================

# ---------------------------------------------------------------------------
#  What does this machine run?  There are four profiles, and compose will list
#  them for you at any time:
#
#      docker compose config --profiles     every profile this file defines
#      docker compose config --services     what your current .env starts
#
#    dev        postgres + redis           a developer's machine
#    gpu        llm-gateway, vllm, infer    a GPU server
#    model      vllm alone                  an extra GPU box, pooled by the
#                                           gateway on another machine
#    ingest     worker                      add to dev, to debug ingest
#
#  Combine with commas: `dev,ingest`, or `gpu,dev` for both roles on one box.
#  Profiles say WHAT RUNS HERE; they are not how you scale (see below).
#  You can also skip this entirely and name services — `docker compose up -d
#  postgres redis` activates their profile on the spot.
#
#  api and web aren't in compose at all: `pnpm dev` runs them on the host
#  so they hot-reload. See the README.
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=dev

# ---------------------------------------------------------------------------
#  Dev role
# ---------------------------------------------------------------------------
# The GPU server to talk to. LLM_BASE_URL and INFER_BASE_URL derive from it.
# localhost assumes an SSH tunnel, which needs no change on the server:
#   ssh -N -L 8602:localhost:8602 -L 8603:localhost:8603 <gpu-host>
GPU_HOST=localhost

# ---------------------------------------------------------------------------
#  GPU role. Ignored unless COMPOSE_PROFILES includes gpu.
# ---------------------------------------------------------------------------
# Which cards vllm and infer may touch. CUDA renumbers whatever you list to
# start at 0, so logs always say "GPU 0" — see the README.
VLLM_GPUS=0
INFER_GPUS=1

# ---------------------------------------------------------------------------
#  Scaling. Deliberately not profiles: adding a service per replica does not
#  extend past two, and cannot describe a GPU on another machine at all.
#
#  MORE GPUs ON THIS MACHINE — vLLM does it inside the one server:
#    TENSOR_PARALLEL   split ONE model across N cards (a model too big for one
#                      card, or a longer context window)
#    DATA_PARALLEL     run N copies and load-balance between them (more
#                      concurrent requests, same model size)
#  They multiply, and the product must equal the number of cards you listed:
#    4 cards, two tensor-parallel pairs:
#      VLLM_GPUS=0,1,2,3   TENSOR_PARALLEL=2   DATA_PARALLEL=2
#    8 cards, one huge model:
#      VLLM_GPUS=0,1,2,3,4,5,6,7   TENSOR_PARALLEL=8
#
#  GPUs ON OTHER MACHINES — the gateway pools a list of addresses, and every
#  machine is described entirely by its own .env:
#
#    machine A   COMPOSE_PROFILES=gpu     BIND_ADDR=0.0.0.0
#                LLM_UPSTREAMS=vllm:8000,gpu-b:8601,gpu-c:8601
#    machine B   COMPOSE_PROFILES=model   BIND_ADDR=0.0.0.0
#    machine C   COMPOSE_PROFILES=model   BIND_ADDR=0.0.0.0
#
#  Then `docker compose up -d` — the same bare command on all three. Sibling
#  container or remote host, the gateway does not care; adding a machine is one
#  more entry in A's list plus `docker compose up -d llm-gateway` there.
# ---------------------------------------------------------------------------
# TENSOR_PARALLEL=1
# DATA_PARALLEL=1
# LLM_UPSTREAMS=vllm:8000
#                      For more than a machine or two, docker/nginx/upstreams is
#                      nicer: one host:port per line, #comments allowed, and it
#                      applies with a graceful `nginx -s reload` instead of a
#                      container recreate. See upstreams.example. The file wins
#                      over this variable when it exists.
# VLLM_PORT=8601       # published so another machine's gateway can reach this vllm

# MODEL_ID and TOOL_CALL_PARSER travel together: the parser must match the format
# the model's chat template emits (EXAONE 4.0 emits Hermes).
#
# !! EXAONE 4.0's licence (§3.1) forbids commercial use of the model AND its
# !! output. Internal / non-revenue use only. For a commercial deployment swap to
# !! Apache-2.0: MODEL_ID=Qwen/Qwen3-32B-AWQ needs no other edit.
MODEL_ID=LGAI-EXAONE/EXAONE-4.0-32B-AWQ
TOOL_CALL_PARSER=hermes

# 0.0.0.0 publishes the gateway and infer beyond loopback, which is what a
# developer's GPU_HOST points at. Neither authenticates, so only on a trusted
# network — the SSH tunnel above is the alternative.
BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
#  Overrides. The commented value is the default; see compose.yaml and
#  apps/api/app/config.py for everything not listed.
# ---------------------------------------------------------------------------
# DATA_ROOT=./data          # weights, uploads, postgres, redis — all under here
# POSTGRES_PORT=5433        # offset from 5432 so it can't hit a local Postgres
# REDIS_PORT=6380
# LLM_GATEWAY_PORT=8602
# INFER_PORT=8603
# API_PORT=8000             # host processes
# WEB_PORT=3000
# ADMIN_EMAIL=dev@agents.dev
# ADMIN_PASSWORD=devdev
# MAX_MODEL_LEN=32768
# GPU_MEMORY_UTILIZATION=0.62
