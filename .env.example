# ============================================================================
#  Copy to .env. This is the only file you edit, on any machine.
#
#      docker compose up -d      docker compose ps
#      docker compose down       docker compose logs -f vllm
#
#  Sections below are grouped by the container they configure, so you can jump
#  to the one you are tuning. Anything commented out shows its default and can
#  stay that way — nothing needs listing just to keep its default.
# ============================================================================


# ─────────────────────────────────────────────────────────────────────────────
#  WHAT THIS MACHINE IS
# ─────────────────────────────────────────────────────────────────────────────
#  dev     postgres + redis            a developer's machine
#  gpu     llm-gateway, vllm, infer    a GPU server
#  model   vllm alone                  an extra GPU box, pooled by gpu's gateway
#  ingest  worker                      add to dev, to debug ingest
#
#  Combine with commas: `dev,ingest`, or `gpu,dev` for both roles on one box.
#  `docker compose config --profiles` lists them; --services shows what this
#  file currently starts.
COMPOSE_PROFILES=dev


# ─────────────────────────────────────────────────────────────────────────────
#  EVERY CONTAINER
# ─────────────────────────────────────────────────────────────────────────────
# 0.0.0.0 publishes ports beyond loopback — required on a GPU server so
# developers and peer gateways can reach it. Nothing here authenticates, so only
# on a trusted network.
BIND_ADDR=127.0.0.1

# DATA_ROOT=./data     weights, uploads, postgres and redis all live under here


# ─────────────────────────────────────────────────────────────────────────────
#  vllm            (profile: gpu, model)          serves the model
# ─────────────────────────────────────────────────────────────────────────────
# Which cards it may use. CUDA renumbers whatever you list to start at 0, so
# logs always say "GPU 0" whichever physical card it is — see the README.
VLLM_GPUS=0

# MODEL_ID and TOOL_CALL_PARSER travel together: the parser must match the format
# the model's chat template emits (EXAONE 4.0 emits Hermes).
#
# !! EXAONE 4.0's licence (§3.1) forbids commercial use of the model AND its
# !! output. Internal / non-revenue use only. For a commercial deployment swap to
# !! Apache-2.0: MODEL_ID=Qwen/Qwen3-32B-AWQ needs no other edit.
MODEL_ID=LGAI-EXAONE/EXAONE-4.0-32B-AWQ
TOOL_CALL_PARSER=hermes

# More cards on THIS machine, without adding a container. They multiply, and the
# product should equal the number of cards in VLLM_GPUS:
#   TENSOR_PARALLEL   split ONE model across N cards (too big for one card, or a
#                     longer context window)
#   DATA_PARALLEL     run N copies inside the one server and balance between them
#                     (more concurrent requests, same model size)
# 4 cards as two tensor-parallel pairs: VLLM_GPUS=0,1,2,3 TENSOR_PARALLEL=2 DATA_PARALLEL=2
# TENSOR_PARALLEL=1
# DATA_PARALLEL=1

# VLLM_PORT=8601             published so another machine's gateway can pool this
# MAX_MODEL_LEN=32768
# GPU_MEMORY_UTILIZATION=0.62   conservative on purpose: leaves room for infer
# SERVED_MODEL_NAME=main
# REASONING_PARSER=
# VLLM_EXTRA_ARGS=


# ─────────────────────────────────────────────────────────────────────────────
#  llm-gateway     (profile: gpu)                 one URL, however many models
# ─────────────────────────────────────────────────────────────────────────────
# The OTHER GPU machines, ip:port, comma separated. This machine's own vllm is
# always in the pool and is never listed. Two or more entries makes the gateway a
# least_conn pool that drops a server after 3 failures and retries after 30s.
#
#   GPU_PEERS=10.0.0.12:8601,10.0.0.13:8601
#
# The port is required — which port a peer publishes is that machine's business.
# Use IP addresses: entries reach nginx unchanged, and a hostname would be
# resolved by the container's DNS, which never reads the host's /etc/hosts.
#
# Changing this needs `docker compose up -d llm-gateway`, not `restart` — a
# container's environment is fixed when it is created.
# GPU_PEERS=

# LLM_GATEWAY_PORT=8602      what developers point GPU_HOST at


# ─────────────────────────────────────────────────────────────────────────────
#  infer           (profile: gpu)                 embeddings, rerank, ASR
# ─────────────────────────────────────────────────────────────────────────────
# Note this defaults to a DIFFERENT card than VLLM_GPUS, so the two do not
# contend. On a single-card box set it to 0 as well and let them share.
INFER_GPUS=1

# INFER_PORT=8603
# EMBED_MODEL=BAAI/bge-m3
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# ASR_MODEL=large-v3
# ASR_COMPUTE_TYPE=int8_float16
# ASR_LANGUAGE=ko


# ─────────────────────────────────────────────────────────────────────────────
#  postgres, redis (profile: dev)                 the app's state
# ─────────────────────────────────────────────────────────────────────────────
# Ports are offset from 5432/6379 so they cannot collide with a Postgres or Redis
# you already run. api builds DATABASE_URL from these — see config.py.
# POSTGRES_PORT=5433
# REDIS_PORT=6380
# POSTGRES_USER=agents
# POSTGRES_PASSWORD=agents
# POSTGRES_DB=agents


# ─────────────────────────────────────────────────────────────────────────────
#  api + web       (not containers)               `pnpm dev`, on your host
# ─────────────────────────────────────────────────────────────────────────────
# The GPU server to talk to. LLM_BASE_URL and INFER_BASE_URL are built from it.
# An IP is fine and needs no DNS. localhost assumes an SSH tunnel:
#   ssh -N -L 8602:localhost:8602 -L 8603:localhost:8603 <gpu-host>
GPU_HOST=localhost

# ADMIN_EMAIL=dev@agents.dev      `pnpm seed` creates/resets this account
# ADMIN_PASSWORD=devdev
#
# The ports for these two are NOT read from here: pnpm does not load .env, so
# they are arguments in package.json, defaulting to 8000 and 3000. Override for
# one run inline — `API_PORT=8123 pnpm api` — or edit the script. Everything else
# in this section does come from this file, because apps/api/app/config.py reads
# it by absolute path.


# ─────────────────────────────────────────────────────────────────────────────
#  Everything else
# ─────────────────────────────────────────────────────────────────────────────
#  OCR, chunking, retrieval, agent and topic tuning are Settings fields in
#  apps/api/app/config.py, each sitting next to the measurement that chose its
#  value. Add any of them here as UPPER_CASE to override.
