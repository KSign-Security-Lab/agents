#!/usr/bin/env bash
# ---------------------------------------------------------------------------
#  ./dev — the only entry point that isn't docker compose.
#
#  Containers are plain compose (`docker compose up -d`, see compose.yaml).
#  This exists for the two things compose can't do: run api and web on the host
#  so they hot-reload, and run the code tasks against a .venv your debugger can
#  attach to. `./dev help` lists everything.
#
#  Config is .env at the repo root — the same file compose reads.
# ---------------------------------------------------------------------------
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
ENV_FILE="$ROOT/.env"
# No -f and no --profile: naming the services activates their profile.
COMPOSE="docker compose"
TARGET="${1:-all}"

die() { echo "error: $*" >&2; exit 1; }
step() { printf '\n\033[36m==> %s\033[0m\n' "$*"; }

[ -f "$ENV_FILE" ] || die "$ENV_FILE not found. Run: cp .env.example .env"
command -v uv >/dev/null || die "uv not found. Install: curl -LsSf https://astral.sh/uv/install.sh | sh"

# Sourced, not passed to compose as --env-file: compose interpolates from the
# environment anyway, and the derivations below need shell expansion.
set -a; . "$ENV_FILE"; set +a

# Derived, so .env only has to name GPU_HOST. Anything already set
# there wins, which is what makes every line in that file an override.
GPU_HOST="${GPU_HOST:-localhost}"
export LLM_BASE_URL="${LLM_BASE_URL:-http://$GPU_HOST:8602/v1}"
export INFER_BASE_URL="${INFER_BASE_URL:-http://$GPU_HOST:8603}"
export POSTGRES_USER="${POSTGRES_USER:-agents}"
export POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-agents}"
export POSTGRES_DB="${POSTGRES_DB:-agents}"
export POSTGRES_PORT="${POSTGRES_PORT:-5433}"
export REDIS_PORT="${REDIS_PORT:-6380}"
export DATA_ROOT="${DATA_ROOT:-./data}"
export API_PORT="${API_PORT:-8000}"
export WEB_PORT="${WEB_PORT:-3000}"
export ADMIN_EMAIL="${ADMIN_EMAIL:-dev@agents.dev}"
export ADMIN_PASSWORD="${ADMIN_PASSWORD:-devdev}"

# The app reads these; both point at the containers this script starts.
export DATABASE_URL="${DATABASE_URL:-postgresql+psycopg://$POSTGRES_USER:$POSTGRES_PASSWORD@localhost:$POSTGRES_PORT/$POSTGRES_DB}"
export REDIS_URL="${REDIS_URL:-redis://localhost:$REDIS_PORT/0}"

# api and the worker container must agree on where uploads live: the worker's
# /storage is this directory bind-mounted.
export STORAGE_ROOT="${STORAGE_ROOT:-$ROOT/${DATA_ROOT#./}/storage}"
export API_INTERNAL_URL="http://localhost:$API_PORT"
mkdir -p "$STORAGE_ROOT"

# ------------------------------------------------------------------ deps
start_deps() {
  step "starting Postgres + Redis"
  # Named explicitly rather than by profile, so this starts the same two
  # containers whether .env says dev, or gpu,dev on a single-box setup.
  if [ -n "${INGEST:-}" ]; then
    $COMPOSE up -d --wait postgres redis worker
  else
    $COMPOSE up -d --wait postgres redis
  fi
}

# --------------------------------------------------------------- python env
# A real venv rather than `uv run --with-requirements`, so an IDE debugger has
# an interpreter to attach to.
VENV="$ROOT/.venv"
STAMP="$VENV/.api-requirements.sha"
ensure_venv() {
  local want
  want="$(cat "$ROOT/docker/requirements/api.txt" "$ROOT/docker/requirements/dev.txt" \
          | shasum -a 256 | cut -d' ' -f1)"
  if [ ! -x "$VENV/bin/python" ] || [ "$(cat "$STAMP" 2>/dev/null || true)" != "$want" ]; then
    step "installing api + dev dependencies into .venv"
    uv venv --python 3.12 "$VENV"
    VIRTUAL_ENV="$VENV" uv pip install -r "$ROOT/docker/requirements/api.txt" \
                                      -r "$ROOT/docker/requirements/dev.txt"
    echo "$want" > "$STAMP"
  fi
}

# cwd must be apps/, not apps/api/: api/__init__.py makes "api" the importable
# package name and Python resolves it from the parent directory. alembic.ini's
# script_location (api/alembic) assumes the same cwd.
run_py() { (cd "$ROOT/apps" && PATH="$VENV/bin:$PATH" PYTHONPATH="$ROOT/apps" "$@"); }

migrate_and_seed() {
  step "applying migrations"
  run_py alembic -c api/alembic.ini upgrade head
  step "seeding admin account"
  run_py python -m api.scripts.seed
}

# ------------------------------------------------------------------ node env
ensure_node() {
  command -v pnpm >/dev/null || die "pnpm not found. Install: npm i -g pnpm@9"
  [ -d "$ROOT/node_modules" ] || { step "pnpm install"; (cd "$ROOT" && pnpm install); }
}

# ------------------------------------------------------------------ processes
PIDS=()
cleanup() {
  trap - INT TERM EXIT
  [ ${#PIDS[@]} -gt 0 ] && kill "${PIDS[@]}" 2>/dev/null || true
  wait 2>/dev/null || true
  echo
  echo "host processes stopped. Containers are still up — 'docker compose down' to stop them."
}

start_api() {
  run_py uvicorn api.app.main:app --reload --port "$API_PORT" &
  PIDS+=($!)
}
start_web() {
  (cd "$ROOT/apps/web" && PATH="$ROOT/node_modules/.bin:$PATH" pnpm dev --port "$WEB_PORT") &
  PIDS+=($!)
}

banner() {
  cat <<EOF

  web    http://localhost:${WEB_PORT}   (login: ${ADMIN_EMAIL} / ${ADMIN_PASSWORD})
  api    http://localhost:${API_PORT:-8000}/docs
  llm    ${LLM_BASE_URL}
  infer  ${INFER_BASE_URL}

  Ctrl-C stops api and web; the containers keep running.
EOF
}

usage() {
  cat <<'EOF'
./dev                    postgres+redis, migrate, seed, then api and web reloading
./dev deps               containers + migrate + seed only, to run api in an IDE
./dev api                just api          ./dev web    just web

./dev test               pytest apps/api/tests
./dev fmt                ruff check --fix (config in apps/ruff.toml)
./dev migrate            alembic upgrade head
./dev revision "add x"   autogenerate a migration
./dev seed               create/reset the admin account
./dev eval               answer + citation accuracy on the Korean gold set
./dev exec CMD…          anything else, in the same venv and environment

Need the worker image (LibreOffice, OCR, ffmpeg):
./dev samples            generate Korean sample documents
./dev ingest FILE        ingest one local file
./dev bboxes DOC_ID      draw stored bboxes onto the pages as PNGs

Containers are docker compose:
  docker compose up -d | down | ps | logs -f <service>
  docker compose config --profiles      what this machine could run
EOF
}

# Tasks needing LibreOffice/OCR go to the worker container; that image is why
# they aren't in the venv.
in_worker() { $COMPOSE up -d --wait worker >/dev/null && $COMPOSE exec -T worker "$@"; }

case "$TARGET" in
  help|-h|--help)
    usage
    ;;
  deps)
    start_deps; ensure_venv; migrate_and_seed
    step "deps ready — point your IDE at $VENV/bin/python, working dir $ROOT/apps"
    ;;
  api)
    ensure_venv
    trap cleanup INT TERM EXIT
    start_api; wait
    ;;
  web)
    ensure_node
    trap cleanup INT TERM EXIT
    start_web; wait
    ;;
  all)
    start_deps; ensure_venv; migrate_and_seed; ensure_node
    trap cleanup INT TERM EXIT
    step "starting api + web"
    start_api; start_web; banner; wait
    ;;
  exec)
    shift
    [ $# -gt 0 ] || die "usage: ./dev exec <command> [args...]"
    ensure_venv; run_py "$@"
    ;;

  test)     ensure_venv; run_py pytest api/tests -q "${@:2}" ;;
  # `ruff format` is deliberately not run here: it would rewrite ~3800 lines in
  # one go, which deserves its own commit rather than riding along with a lint fix.
  fmt)      ensure_venv; run_py ruff check --fix api ;;
  migrate)  ensure_venv; run_py alembic -c api/alembic.ini upgrade head ;;
  revision)
    [ -n "${2:-}" ] || die 'usage: ./dev revision "add x"'
    ensure_venv; run_py alembic -c api/alembic.ini revision --autogenerate -m "$2"
    ;;
  seed)     ensure_venv; run_py python -m api.scripts.seed ;;
  eval)     ensure_venv; run_py python -m api.scripts.run_eval ;;

  samples)
    $COMPOSE run --rm --no-deps -v "$ROOT:/work" -w /work \
      worker python scripts/make_samples.py samples
    ;;
  ingest)
    [ -n "${2:-}" ] || die "usage: ./dev ingest <path>"
    in_worker python -m api.scripts.ingest_local "/storage/../$2"
    ;;
  bboxes)
    [ -n "${2:-}" ] || die "usage: ./dev bboxes <document-id>"
    in_worker python -m api.scripts.citation_check "$2"
    echo "==> wrote ${DATA_ROOT#./}/out/ — open the PNGs and check the boxes cover the right text"
    ;;

  *) die "unknown command '$TARGET' — try: ./dev help" ;;
esac
