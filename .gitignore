# Secrets — generated from the .example files by `make setup` / `make dev-setup`
docker/.env
docker/.env.dev
*.pem
*.key

# Runtime data (Postgres/Redis/storage) — DATA_ROOT default is ./data under docker/
docker/data/
docker/devdata/

# Generated sample documents (recreate with: make samples)
samples/*
!samples/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo
.turbo/

# Local runtime output
out/
logs/
