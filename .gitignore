# Machine config — copied from .env.example, never committed
.env
*.pem
*.key

# Runtime data: weights, uploads, postgres, redis. DATA_ROOT default.
data/

# Generated sample documents (recreate with: make samples)
samples/*
!samples/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo
.turbo/

# Local runtime output
out/
logs/

