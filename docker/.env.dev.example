# ============================================================================
#  Local development (`make dev`).
#
#  One line matters: where the GPU server is. Everything else is derived or
#  defaulted — ports, URLs, the dev admin account — so there is nothing to keep
#  in step by hand. Uncomment below only to override.
# ============================================================================

# The GPU server running `make gpu`. LLM_BASE_URL and INFER_BASE_URL are
# built from this. Default assumes an SSH tunnel, which needs no firewall or
# server change:
#   ssh -N -L 8602:localhost:8602 -L 8603:localhost:8603 <gpu-host>
# If that box publishes the ports instead (BIND_ADDR=0.0.0.0 in its
# docker/.env), put its hostname here and skip the tunnel.
GPU_HOST=localhost

# ---------------------------------------------------------------------------
#  Overrides. The commented value is what you get if you leave it alone.
# ---------------------------------------------------------------------------
# LLM_BASE_URL=http://$GPU_HOST:8602/v1     # set to bypass GPU_HOST entirely
# INFER_BASE_URL=http://$GPU_HOST:8603
# POSTGRES_PORT=5433        # offset from 5432 so it can't hit a local Postgres
# REDIS_PORT=6380           # likewise, offset from 6379
# API_PORT=8000
# WEB_PORT=3000
# ADMIN_EMAIL=dev@agents.dev
# ADMIN_PASSWORD=devdev
# DEV_DATA_ROOT=./devdata   # relative to docker/
