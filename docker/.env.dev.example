# ============================================================================
#  Local development. Copy to docker/.env.dev (`make dev-setup`) and edit the
#  GPU_HOST line — that is normally the only line you need to touch.
#
#  Everything GPU-bound (the LLM and the embed/rerank/ASR sidecar) runs on the
#  shared GPU server. Postgres and Redis run in Docker locally. api and web run
#  on your host with hot reload. See README "Local development".
# ============================================================================

# ---------------------------------------------------------------------------
#  Where the GPU server is.
#
#  Default assumes an SSH tunnel, which needs no firewall or server change:
#    ssh -N -L 8602:localhost:8602 -L 8603:localhost:8603 <gpu-host>
#  If the GPU box publishes those ports on the network instead (BIND_ADDR=0.0.0.0
#  in its docker/.env), put its hostname here and skip the tunnel.
# ---------------------------------------------------------------------------
GPU_HOST=localhost
LLM_BASE_URL=http://${GPU_HOST}:8602/v1
INFER_BASE_URL=http://${GPU_HOST}:8603
LLM_API_KEY=dummy
SERVED_MODEL_NAME=main
MAX_MODEL_LEN=32768
TOOL_CALL_PARSER=hermes

# ---------------------------------------------------------------------------
#  Local deps (started by `make dev`). Ports are offset from the usual 5432/6379
#  so they can't collide with a Postgres or Redis you already run.
# ---------------------------------------------------------------------------
DEV_DATA_ROOT=./devdata
POSTGRES_USER=agents
POSTGRES_PASSWORD=agents
POSTGRES_DB=agents
POSTGRES_PORT=5433
REDIS_PORT=6380

# Host-side URLs, used by api/worker when they run outside Docker.
DATABASE_URL=postgresql+psycopg://agents:agents@localhost:5433/agents
REDIS_URL=redis://localhost:6380/0

# ---------------------------------------------------------------------------
#  Host processes
# ---------------------------------------------------------------------------
API_PORT=8000
WEB_PORT=3000

# Not a secret in dev: the web tier signs nothing, it only relays the token the
# api mints, so both sides just need the same string.
INTERNAL_JWT_SECRET=dev-secret
INTERNAL_JWT_TTL_MINUTES=720

# First-run admin account (`make dev` seeds it). Pin the password so every
# developer's local login is the same and nobody has to read the log.
ADMIN_EMAIL=dev@agents.dev
ADMIN_PASSWORD=devdev

# Ingest tuning: on a laptop, OCR on CPU is the slow part.
OCR_USE_GPU=false
