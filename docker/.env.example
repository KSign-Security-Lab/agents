# ============================================================================
#  Deployment config for the full single-node stack (`make up`).
#
#  Only decisions live here. Everything else already has a default:
#    docker/compose.yml            ${VAR:-default} for paths, ports, models
#    apps/api/app/config.py        the Settings class — OCR, chunking, agent,
#                                  retrieval and topic tuning, each with the
#                                  measurement that chose the value
#
#  To override any Settings field, add it here as UPPER_CASE. Nothing needs to
#  be listed just to keep its default.
#
#  Developing rather than deploying? You want docker/.env.dev — see the README.
# ============================================================================

# ---------------------------------------------------------------------------
#  Storage. Point these at a volume with room: weights ~30GB, plus Postgres and
#  uploads. Everything the stack writes lives under these three paths.
# ---------------------------------------------------------------------------
DATA_ROOT=./data
MODEL_DIR=./data/models/vllm
INFER_MODEL_DIR=./data/models/infer

# ---------------------------------------------------------------------------
#  GPUs. Values are CUDA device indices — set them to whichever cards are free.
#    single : one replica on VLLM_A_GPUS            (1 GPU)
#    tp2    : ONE model SPLIT across LLM_TP2_GPUS   (too large for one card, or
#             a longer context window)
#    dp2    : TWO replicas splitting load, nginx least_conn
#  Switch with `make llm-mode MODE=...`; the app only ever sees LLM_BASE_URL.
# ---------------------------------------------------------------------------
LLM_MODE=single
VLLM_A_GPUS=0
INFER_GPUS=1
# VLLM_B_GPUS=1        # LLM_MODE=dp2
# LLM_TP2_GPUS=0,1     # LLM_MODE=tp2

# ---------------------------------------------------------------------------
#  Model. MODEL_ID and TOOL_CALL_PARSER travel together: the parser has to match
#  the format the model's chat template emits (EXAONE 4.0 emits Hermes).
#
#  !! EXAONE 4.0's licence (§3.1) forbids commercial use of the model AND its
#  !! output. Internal / non-revenue use only. For a commercial deployment swap
#  !! to Apache-2.0: MODEL_ID=Qwen/Qwen3-32B-AWQ needs no other edit.
# ---------------------------------------------------------------------------
MODEL_ID=LGAI-EXAONE/EXAONE-4.0-32B-AWQ
TOOL_CALL_PARSER=hermes
# xgrammar will emit unbounded whitespace between JSON tokens, letting a model
# stall forever mid-object. Disabling any whitespace makes guided decoding
# terminate reliably. (Not defaultable in compose: the JSON contains a '}'.)
STRUCTURED_OUTPUTS_CONFIG={"disable_any_whitespace":true,"backend":"xgrammar"}

# ---------------------------------------------------------------------------
#  Secrets. `make setup` replaces both placeholders with generated values.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-in-env
INTERNAL_JWT_SECRET=change-me-too

# ---------------------------------------------------------------------------
#  Network exposure. 0.0.0.0 publishes llm-gateway and infer beyond loopback,
#  which is what a remote developer's GPU_HOST points at. Neither service
#  authenticates, so only do that on a trusted network — an SSH tunnel is the
#  alternative and needs no change here.
# ---------------------------------------------------------------------------
BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
#  Host ports — uncomment only to resolve a collision.
# ---------------------------------------------------------------------------
# WEB_PORT=8600
# API_PORT=8601
# LLM_GATEWAY_PORT=8602
# INFER_PORT=8603
# POSTGRES_PORT=8604

# ---------------------------------------------------------------------------
#  Occasionally useful overrides. Defaults shown; see config.py for the rest.
# ---------------------------------------------------------------------------
# MAX_MODEL_LEN=32768
# GPU_MEMORY_UTILIZATION=0.62
# OCR_ENGINE=easyocr              # easyocr | rapidocr | tesseract
# OCR_USE_GPU=false
# MAX_UPLOAD_MB=512
# WEB_SEARCH_ENABLED=false
