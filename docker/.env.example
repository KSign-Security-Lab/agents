# ============================================================================
#  GPU side (`make gpu`). Eight values, all of them a real decision.
#
#  Defaults for everything else live in docker/compose.gpu.yml as
#  ${VAR:-default}. Nothing needs to be listed here to keep its default.
#
#  The dev side has its own file, docker/.env.dev — one line. See the README.
# ============================================================================

# Where weights and any media this box transcribes are kept. ~30GB for the LLM.
GPU_DATA_ROOT=./gpudata
MODEL_DIR=./gpudata/models/vllm
INFER_MODEL_DIR=./gpudata/models/infer

# CUDA device indices — set them to whichever cards are free.
#   single : one replica on VLLM_A_GPUS            (1 GPU)
#   tp2    : ONE model SPLIT across LLM_TP2_GPUS   (too big for one card, or a
#            longer context window)
#   dp2    : TWO replicas splitting load, nginx least_conn
# `make gpu MODE=tp2` switches and remembers.
LLM_MODE=single
VLLM_A_GPUS=0
INFER_GPUS=1
# VLLM_B_GPUS=1        # MODE=dp2
# LLM_TP2_GPUS=0,1     # MODE=tp2

# MODEL_ID and TOOL_CALL_PARSER travel together: the parser must match the format
# the model's chat template emits (EXAONE 4.0 emits Hermes).
#
# !! EXAONE 4.0's licence (§3.1) forbids commercial use of the model AND its
# !! output. Internal / non-revenue use only. For a commercial deployment swap to
# !! Apache-2.0: MODEL_ID=Qwen/Qwen3-32B-AWQ needs no other edit.
MODEL_ID=LGAI-EXAONE/EXAONE-4.0-32B-AWQ
TOOL_CALL_PARSER=hermes
# xgrammar will emit unbounded whitespace between JSON tokens, letting a model
# stall forever mid-object. Disabling any whitespace makes guided decoding
# terminate. (Not defaultable in compose: the JSON contains a '}'.)
STRUCTURED_OUTPUTS_CONFIG={"disable_any_whitespace":true,"backend":"xgrammar"}

# 0.0.0.0 publishes the gateway and infer beyond loopback, which is what a
# developer's GPU_HOST points at. Neither authenticates, so only on a trusted
# network — an SSH tunnel is the alternative and needs no change here.
BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
#  Occasional overrides; the commented value is the default.
# ---------------------------------------------------------------------------
# LLM_GATEWAY_PORT=8602
# INFER_PORT=8603
# MAX_MODEL_LEN=32768
# GPU_MEMORY_UTILIZATION=0.62
