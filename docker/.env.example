# ============================================================================
#  Paths
# ----------------------------------------------------------------------------
#  Point these at a volume with room to spare. Model weights alone are ~30GB,
#  and Postgres plus uploaded documents grow from there. Everything the stack
#  writes lives under these three directories and nowhere else, so moving the
#  deployment to different storage is a change to this file only.
#
#    DATA_ROOT        postgres data, uploaded files, redis, logs   (~5GB + docs)
#    MODEL_DIR        HF cache for the LLM served by vLLM          (~20GB)
#    INFER_MODEL_DIR  HF cache for embeddings / reranker / ASR     (~10GB)
# ============================================================================
DATA_ROOT=./data
MODEL_DIR=./data/models/vllm
INFER_MODEL_DIR=./data/models/infer

# ============================================================================
#  Ports (host side). Change any that collide with something already running.
# ============================================================================
# BIND_ADDR=0.0.0.0 also publishes llm-gateway and infer on the network, which
# is what remote developers point docker/.env.dev's GPU_HOST at. Leave it at the
# loopback default unless the host is on a trusted network: neither service
# authenticates. An SSH tunnel is the alternative and needs no change here.
BIND_ADDR=127.0.0.1

WEB_PORT=8600
API_PORT=8601
LLM_GATEWAY_PORT=8602
INFER_PORT=8603
POSTGRES_PORT=8604

# ============================================================================
#  LLM serving topology — the app only ever talks to LLM_BASE_URL
# ----------------------------------------------------------------------------
#  LLM_MODE=single : one replica on VLLM_A_GPUS       (needs 1 free GPU)
#  LLM_MODE=tp2    : ONE model SPLIT across two GPUs  (tensor parallel; for a
#                    model too large for one card, or a longer context window)
#  LLM_MODE=dp2    : TWO replicas SPLITTING the load  (nginx least_conn)
#
#  VLLM_A_GPUS / VLLM_B_GPUS / LLM_TP2_GPUS are CUDA device indices. Set them to
#  whichever cards are free; the application only ever talks to LLM_BASE_URL.
# ============================================================================
LLM_MODE=single
VLLM_A_GPUS=0
VLLM_B_GPUS=1
LLM_TP2_GPUS=0,1

MODEL_ID=LGAI-EXAONE/EXAONE-4.0-32B-AWQ
# !! EXAONE 4.0's licence (§3.1) forbids commercial use of the model AND its
# !! output. Internal / non-revenue use only. For a commercial deployment swap
# !! to an Apache-2.0 model, e.g. MODEL_ID=Qwen/Qwen3-32B-AWQ
SERVED_MODEL_NAME=main
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.62
# EXAONE 4.0 emits <tool_call>{...}</tool_call>, which is the Hermes format.
# Verified against the model chat template at bring-up.
TOOL_CALL_PARSER=hermes
REASONING_PARSER=
# xgrammar will happily emit unbounded whitespace between JSON tokens, which
# lets a model stall forever mid-object instead of finishing it. Disabling any
# whitespace makes guided decoding terminate reliably.
STRUCTURED_OUTPUTS_CONFIG={"disable_any_whitespace":true,"backend":"xgrammar"}
VLLM_EXTRA_ARGS=

LLM_BASE_URL=http://llm-gateway/v1
LLM_API_KEY=dummy
LLM_TIMEOUT_S=300

# ============================================================================
#  Inference sidecar (embeddings + reranker + ASR, one container)
# ============================================================================
INFER_GPUS=1
INFER_BASE_URL=http://infer:8000
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
SPARSE_DIM=250002
RERANK_MODEL=BAAI/bge-reranker-v2-m3
ASR_MODEL=large-v3
ASR_COMPUTE_TYPE=int8_float16
ASR_LANGUAGE=ko

# ============================================================================
#  Ingest
# ============================================================================
OCR_ENGINE=easyocr          # easyocr | rapidocr | tesseract
# direct = call the OCR engine and keep its line-level boxes (default; better
# text recall and finer geometry on Korean scans). docling = full Docling
# pipeline, which recovers table cells on scans but dropped body paragraphs.
OCR_LAYOUT_ENGINE=direct
OCR_DPI=200
OCR_MIN_CONFIDENCE=0.25
OCR_USE_GPU=false
OCR_LANGS=ko,en
ENABLE_KEYFRAME_OCR=false
MAX_UPLOAD_MB=512
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
TRANSCRIPT_WINDOW_S=45
TOPIC_MERGE_THRESHOLD=0.85     # auto-merge near-identical labels only
TOPIC_SUGGEST_THRESHOLD=0.70   # 0.70-0.85 surfaces as an admin merge suggestion

# ============================================================================
#  Agent
# ============================================================================
MAX_SUBAGENTS=4
MAX_RETRIEVE_ITERATIONS=3
CORPUS_ESCALATION=true
RETRIEVE_TOP_K=40
RERANK_TOP_K=10
SENTENCE_ALIGN_THRESHOLD=0.55
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=none    # none | tavily | brave | searxng
WEB_SEARCH_API_KEY=

# ============================================================================
#  Postgres / Redis / auth
# ============================================================================
POSTGRES_USER=agents
POSTGRES_PASSWORD=change-me-in-env
POSTGRES_DB=agents
DATABASE_URL=postgresql+psycopg://agents:change-me-in-env@postgres:5432/agents
REDIS_URL=redis://redis:6379/0

# Shared secret the Next.js BFF uses to mint short-lived internal JWTs
INTERNAL_JWT_SECRET=change-me-too
INTERNAL_JWT_TTL_MINUTES=720
AUTH_SECRET=change-me-three
NEXTAUTH_URL=http://localhost:8600
API_INTERNAL_URL=http://api:8000
