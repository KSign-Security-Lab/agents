# Rendered at container start by entrypoint.sh from LLM_MODE.
# The renderer replaces two marker lines (see entrypoint.sh) with the upstream
# definition and the proxy target for the active GPU topology. Do not repeat
# those marker tokens elsewhere in this file: substitution is line-wise.
#UPSTREAM_BLOCK#

server {
    listen 80;
    server_name _;

    # Docker's embedded DNS. With a variable proxy_pass, nginx resolves the
    # backend per request instead of at start-up, so the gateway comes up (and
    # answers 502) even while a replica is still loading its weights, which
    # takes minutes for a 30B model.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Generation can legitimately take minutes; never let the proxy cut it off.
    proxy_read_timeout    900s;
    proxy_send_timeout    900s;
    proxy_connect_timeout 15s;
    client_max_body_size  64m;

    # Token streaming must not be buffered.
    proxy_buffering off;
    proxy_cache off;
    chunked_transfer_encoding on;

    location = /gateway/health {
        access_log off;
        add_header Content-Type application/json;
        return 200 '{"status":"ok","mode":"#MODE#"}';
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_next_upstream error timeout http_502 http_503 http_504;
#PROXY_TARGET#
    }
}
